# Copy to .env and fill in. `.env` is gitignored, so THIS file is the only
# record of which variables the app needs — keep it in sync when adding one.
#
# Every VITE_* value is inlined into the bundle at BUILD time and is therefore
# public. Never put a real secret here or in .env.

# DEV -> talks to http://localhost:3000 ; PROD -> talks to VITE_DOMAIN_BE_PROD
VITE_ENVIRONMENT=DEV
VITE_DOMAIN_BE_PROD=https://your-backend.run.app

# Must match EXTENSION_SECRET_KEY in the backend .env
VITE_EXTENSION_SECRET_KEY=
VITE_GOOGLE_CLIENT_ID=

# Comma-separated admin allow-list. Unset => defaults to SUPPORT_EMAIL in
# src/config.js. The backend enforces its own list; this only drives the UI.
# VITE_ADMIN_EMAILS=

# --- Firebase Cloud Messaging (admin + teacher push notifications) ---
# From Firebase Console -> Project settings -> General -> Your apps -> Web.
#
# IMPORTANT: the same six values are ALSO hard-coded in
# public/firebase-messaging-sw.js — a classic service worker cannot read
# import.meta.env. Keep the two in sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# = the GCP project number
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console -> Cloud Messaging -> Web Push certificates -> Generate key
# pair. ~87 chars, starts with "B". Lives ONLY here: the service worker never
# calls getToken(), so it does not need it. Without this, the bell still works
# but the "enable push" button stays hidden (see IS_PUSH_CONFIGURED).
VITE_FIREBASE_VAPID_KEY=
